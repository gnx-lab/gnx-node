#!/usr/sbin/nft -f
# Capacidad: ingress del nodo
# Implementación aprobada: nftables
# Permite DNS y HTTPS solo por tailscale0/loopback; no expone 8006.
table inet gnx_ingress {
  chain dns_redirect {
    type nat hook prerouting priority dstnat; policy accept;
    iifname "tailscale0" udp dport 53 redirect to :5353
    iifname "tailscale0" tcp dport 53 redirect to :5353
  }
  chain dns_local_redirect {
    type nat hook output priority dstnat; policy accept;
    ip daddr 100.64.0.0/10 udp dport 53 redirect to :5353
    ip daddr 100.64.0.0/10 tcp dport 53 redirect to :5353
  }
  chain input {
    type filter hook input priority 0; policy drop;
    # Permit replies to connections initiated by the node on any egress interface.
    # This is state-only; new inbound service connections remain interface-scoped below.
    ct state established,related accept
    iifname "lo" accept
    # Prerouting has already translated public DNS :53 to Pi-hole :5353
    # before this input hook runs.
    iifname "tailscale0" udp dport 5353 accept
    iifname "tailscale0" tcp dport 5353 accept
    iifname "tailscale0" tcp dport 443 accept
    # Windows portproxy reaches WSL through the private NAT interface. The
    # interface is not LAN-facing; limit the source to WSL's private RFC1918
    # range so local app.gnx/compute.gnx survive a Windows reboot.
    iifname "eth0" ip saddr 172.16.0.0/12 tcp dport 443 accept
  }
}
