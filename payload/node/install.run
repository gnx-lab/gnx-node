#!/usr/bin/env bash
# Capacidad: runtime Linux de GnX Node
# Implementación aprobada: Podman + Quadlets bajo systemd
# Entrada: --payload-dir y --state-dir; los secretos solo llegan por ruta efímera
set -Eeuo pipefail
IFS=$'\n\t'
usage() { printf '%s\n' 'usage: install.run check|install --payload-dir DIR --state-dir DIR'; }
die() { printf '{"event":"error","code":"%s"}\n' "$1" >&2; exit 1; }
mode="${1:-}"
[[ "$mode" == check || "$mode" == install ]] || { usage >&2; exit 64; }
shift
payload_dir=""; state_dir=""
while (($#)); do
  case "$1" in
    --payload-dir) (($# >= 2)) || die INVALID_ARGUMENT; payload_dir=$2; shift 2 ;;
    --state-dir) (($# >= 2)) || die INVALID_ARGUMENT; state_dir=$2; shift 2 ;;
    --help) usage; exit 0 ;;
    *) die INVALID_ARGUMENT ;;
  esac
done
[[ -n "$payload_dir" && -n "$state_dir" ]] || die MISSING_PATH
[[ -d "$payload_dir/services" && -f "$payload_dir/verify.run" ]] || die PAYLOAD_INVALID
emit() { printf '{"event":"%s"}\n' "$1"; }
require_cmd() { command -v "$1" >/dev/null 2>&1 || die "MISSING_${1^^}"; }
check_prereqs() {
  [[ "$(id -u)" == 0 ]] || die ROOT_REQUIRED
  require_cmd systemctl; require_cmd install
  [[ -d /run/systemd/system ]] || die SYSTEMD_REQUIRED
  [[ -c /dev/net/tun ]] || die TUN_UNAVAILABLE
  [[ -c /dev/kvm ]] || die KVM_UNAVAILABLE
  if ! command -v podman >/dev/null 2>&1 && [[ "$mode" == check ]]; then die PODMAN_MISSING; fi
}
check_prereqs
if [[ "$mode" == check ]]; then emit check_ok; exit 0; fi
if ! command -v podman >/dev/null 2>&1; then
  if command -v apt-get >/dev/null 2>&1; then apt-get update >/dev/null && DEBIAN_FRONTEND=noninteractive apt-get install -y podman >/dev/null
  elif command -v dnf >/dev/null 2>&1; then dnf install -y podman >/dev/null
  else die PODMAN_INSTALL_UNSUPPORTED; fi
fi
require_cmd podman
unit_dir=/etc/containers/systemd; runtime_dir=/var/lib/gnx-node
install -d -m 0755 "$unit_dir" "$runtime_dir" "$state_dir" "$runtime_dir/web-app" "$runtime_dir/ca"
install -d -m 0700 /etc/gnx/secrets
for unit in mesh dns gateway compute platform; do install -m 0644 "$payload_dir/services/$unit.$([[ "$unit" == platform ]] && echo target || echo container)" "$unit_dir/"; done
install -m 0644 "$payload_dir/gateway/routes.conf" "$runtime_dir/routes.conf"
install -m 0644 "$payload_dir/network/ingress.nft" "$runtime_dir/ingress.nft"
cp -a "$payload_dir/web-app/." "$runtime_dir/web-app/"; chmod -R a-w "$runtime_dir/web-app"
chmod 0755 "$payload_dir/verify.run"
if command -v nft >/dev/null 2>&1; then nft delete table inet gnx_ingress 2>/dev/null || true; nft -f "$runtime_dir/ingress.nft"; fi
systemctl daemon-reload; systemctl enable --now platform.target >/dev/null
emit installed
