# Capacidad: mesh
# Implementación aprobada para este release: Tailscale
# Requisitos: /dev/net/tun y clave efímera consumida por el agente
[Unit]
Description=GnX private mesh capability
Wants=network-online.target
After=network-online.target
Before=platform.target
[Container]
Image=docker.io/tailscale/tailscale@sha256:2667499ed87ae29218f292556ba062918402dd5e92e93637af14867e4df12dd3
ContainerName=gnx-mesh
Network=host
AddDevice=/dev/net/tun
AddCapability=NET_ADMIN
AddCapability=NET_RAW
Volume=/var/lib/gnx-node/mesh:/var/lib/tailscale:Z
Environment=TS_STATE_DIR=/var/lib/tailscale
Environment=TS_USERSPACE=false
Environment=TS_ACCEPT_DNS=false
EnvironmentFile=/run/gnx-node/mesh.env
[Service]
Restart=always
RestartSec=5s
[Install]
WantedBy=multi-user.target
