# Capacidad: compute.gnx
# Implementación aprobada para este release: imagen sellada Proxmox
# Entrada interna: HTTPS 8006; requisitos: /dev/kvm y CA de backend
# Exposición permitida: gateway.container mediante loopback únicamente
[Unit]
Description=GnX compute capability
After=mesh.service
Requires=mesh.service
[Container]
Image=docker.io/dockurr/proxmox@sha256:135292c3d3cbc8061ad6c70f1097f213d4de20275d5a1e679de580a254f1018c
ContainerName=gnx-compute
PublishPort=127.0.0.1:8006:8006
AddDevice=/dev/kvm
AddDevice=/dev/fuse
PodmanArgs=--privileged --hostname=gnx-compute
HealthCmd=/usr/bin/curl --fail --silent --show-error --connect-timeout 3 --max-time 5 --cacert /etc/gnx/ca/backend-ca.pem --resolve compute.gnx:8006:127.0.0.1 https://compute.gnx:8006/
HealthInterval=30s
HealthRetries=3
HealthStartPeriod=5m
HealthOnFailure=kill
Notify=healthy
Volume=/var/lib/gnx-node/compute:/var/lib/vz:Z
Volume=/var/lib/gnx-node/compute-config:/var/lib/pve-cluster:Z
Volume=/var/lib/gnx-node/compute-config/hostname:/etc/hostname:ro,Z
Volume=/var/lib/gnx-node/compute-systemd/pveproxy.service.d:/etc/systemd/system/pveproxy.service.d:ro,Z
Volume=/var/lib/gnx-node/compute-hook/install-tls.sh:/usr/local/libexec/gnx-install-tls.sh:ro,Z
Volume=/var/lib/gnx-node/ca:/etc/gnx/ca:ro,Z
EnvironmentFile=/var/lib/gnx-node/secrets/compute.env
[Service]
Restart=always
RestartSec=10s
TimeoutStartSec=8min
TimeoutStopSec=2min
[Install]
WantedBy=platform.target
