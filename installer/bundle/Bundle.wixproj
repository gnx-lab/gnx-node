<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <OutputType>Bundle</OutputType>
    <OutputName>GnxNodeSetup</OutputName>
    <!-- WiX 5 localizes package output under the en-us folder. Keep this
         absolute and deterministic so Burn always embeds the MSI just built. -->
    <MsiPackage>$(MSBuildProjectDirectory)\..\..\build\installer\en-us\GnxNode.msi</MsiPackage>
    <DefineConstants>MsiPackage=$(MsiPackage)</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.Bal.wixext" Version="5.0.2" />
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
    <Compile Include="Bundle.wxs" />
  </ItemGroup>
</Project>
