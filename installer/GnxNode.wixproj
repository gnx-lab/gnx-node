<Project Sdk="WixToolset.Sdk/5.0.2"><PropertyGroup><EnableDefaultCompileItems>false</EnableDefaultCompileItems><OutputName>GnxNode</OutputName><HostAgentExe>$(MSBuildProjectDirectory)\..\target\release\gnx-host-agent.exe</HostAgentExe><SetupExe>$(MSBuildProjectDirectory)\..\target\release\gnx-setup.exe</SetupExe><SetupUi>$(MSBuildProjectDirectory)\..\apps\setup\ui\index.html</SetupUi><HostPayload>$(MSBuildProjectDirectory)\..\payload\host</HostPayload><DefineConstants>HostAgentExe=$(HostAgentExe);SetupExe=$(SetupExe);SetupUi=$(SetupUi);HostPayload=$(HostPayload)</DefineConstants></PropertyGroup><ItemGroup><Compile Include="Product.wxs" /></ItemGroup></Project>
