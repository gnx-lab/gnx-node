<Project Sdk="WixToolset.Sdk/5.0.2"><PropertyGroup><EnableDefaultCompileItems>false</EnableDefaultCompileItems><OutputName>GnxNode</OutputName><HostAgentExe>$(MSBuildProjectDirectory)\..\target\release\gnx-host-agent.exe</HostAgentExe><SetupExe>$(MSBuildProjectDirectory)\..\target\release\gnx-setup.exe</SetupExe><SetupUi>$(MSBuildProjectDirectory)\..\apps\setup\ui\index.html</SetupUi><SetupCss>$(MSBuildProjectDirectory)\..\apps\setup\ui\styles.css</SetupCss><SetupJs>$(MSBuildProjectDirectory)\..\apps\setup\ui\app.js</SetupJs><HostPayload>$(MSBuildProjectDirectory)\..\payload\host</HostPayload><NodePayload>$(MSBuildProjectDirectory)\..\build\payload\node</NodePayload><DefineConstants>HostAgentExe=$(HostAgentExe);SetupExe=$(SetupExe);SetupUi=$(SetupUi);SetupCss=$(SetupCss);SetupJs=$(SetupJs);HostPayload=$(HostPayload);NodePayload=$(NodePayload)</DefineConstants></PropertyGroup><ItemGroup><Compile Include="Product.wxs" /></ItemGroup></Project>
